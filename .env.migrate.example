# Variables para scripts/migrate-to-r2h.ts
# Copia este archivo a .env.migrate y completa los valores.
# .env.migrate está en .gitignore — nunca lo subas al repo.

# Plan B — proyecto InsForge del landing de emergencia
PLANB_INSFORGE_URL=https://3e9sriq7.us-east.insforge.app
PLANB_SERVICE_KEY=          # service role key de Plan B (no la anon key)

# R2H — proyecto InsForge de Ready2Hybrid
R2H_INSFORGE_URL=           # URL del proyecto R2H en InsForge
R2H_SERVICE_KEY=            # service role key de R2H

# Código del evento tal como está sembrado en la tabla events de R2H
R2H_EVENT_CODE=HEX-2026
